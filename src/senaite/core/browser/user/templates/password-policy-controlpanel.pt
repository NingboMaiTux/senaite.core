<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="senaite.core"
      metal:use-macro="context/main_template/macros/master">
  <body>
    <metal:content fill-slot="content-core">
      <div class="documentContent">
        <h1 i18n:translate="title_password_policy">Password Policy</h1>
        <p i18n:translate="help_password_policy_intro">
          Configure the custom password rules used by the site. These settings
          are intended for administrator maintenance and will be applied by the
          password validation logic in the next step.
        </p>

        <form method="post"
              tal:attributes="action string:${context/absolute_url}/@@password-policy-controlpanel">
          <input tal:replace="structure context/@@authenticator/authenticator" />

          <fieldset>
            <legend i18n:translate="fieldset_password_policy_basic">Basic Settings</legend>

            <div class="field">
              <label for="password-policy-enabled">
                <input id="password-policy-enabled"
                       type="checkbox"
                       name="enabled"
                       value="1"
                       tal:attributes="checked python:view.enabled() and 'checked' or None" />
                <span i18n:translate="label_password_policy_enabled">Enable password policy</span>
              </label>
            </div>

            <div class="field">
              <label for="password-policy-min-length"
                     i18n:translate="label_password_policy_min_length">Minimum password length</label>
              <input id="password-policy-min-length"
                     type="text"
                     name="min_length"
                     tal:attributes="value python:view.min_length()" />
            </div>
          </fieldset>

          <fieldset>
            <legend i18n:translate="fieldset_password_policy_complexity">Complexity Rules</legend>

            <div class="field">
              <label for="password-policy-uppercase">
                <input id="password-policy-uppercase"
                       type="checkbox"
                       name="require_uppercase"
                       value="1"
                       tal:attributes="checked python:view.require_uppercase() and 'checked' or None" />
                <span i18n:translate="label_password_policy_require_uppercase">Require at least one uppercase letter</span>
              </label>
            </div>

            <div class="field">
              <label for="password-policy-lowercase">
                <input id="password-policy-lowercase"
                       type="checkbox"
                       name="require_lowercase"
                       value="1"
                       tal:attributes="checked python:view.require_lowercase() and 'checked' or None" />
                <span i18n:translate="label_password_policy_require_lowercase">Require at least one lowercase letter</span>
              </label>
            </div>

            <div class="field">
              <label for="password-policy-digit">
                <input id="password-policy-digit"
                       type="checkbox"
                       name="require_digit"
                       value="1"
                       tal:attributes="checked python:view.require_digit() and 'checked' or None" />
                <span i18n:translate="label_password_policy_require_digit">Require at least one digit</span>
              </label>
            </div>

            <div class="field">
              <label for="password-policy-special">
                <input id="password-policy-special"
                       type="checkbox"
                       name="require_special"
                       value="1"
                       tal:attributes="checked python:view.require_special() and 'checked' or None" />
                <span i18n:translate="label_password_policy_require_special">Require at least one special character</span>
              </label>
            </div>
          </fieldset>

          <div class="formControls">
            <input class="context"
                   type="submit"
                   name="form.save"
                   value="Save"
                   i18n:attributes="value" />
            <input class="standalone"
                   type="submit"
                   name="form.cancel"
                   value="Cancel"
                   i18n:attributes="value" />
          </div>
        </form>
      </div>
    </metal:content>
  </body>
</html>
